rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == "cortado202@gmail.com"
      );
    }

    // Site Settings: Publicly readable, writable
    match /siteSettings/{settingId} {
      allow read, write: if true;
    }

    // Site Data (unified store config document): Publicly readable, writable
    match /site_data/{docId} {
      allow read, write: if true;
    }

    // Categories: Publicly readable, writable
    match /categories/{catId} {
      allow read, write: if true;
    }

    // Products: Publicly readable, writable
    match /products/{productId} {
      allow read, write: if true;
    }

    // Orders: Anyone can create order, read, update
    match /orders/{orderId} {
      allow read, write: if true;
    }

    // Promo Codes: Publicly readable, writable
    match /promoCodes/{promoId} {
      allow read, write: if true;
    }

    // Customers: Publicly readable, writable
    match /customers/{customerId} {
      allow read, write: if true;
    }

    // Default match
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
